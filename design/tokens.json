{
  "$comment": "Single source of design tokens for the profile README cards and the portfolio site.",
  "font": {
    "sans": "Inter",
    "mono": "Geist Mono",
    "weights": { "regular": 400, "strong": 600 }
  },
  "radius": { "card": 14, "panel": 18, "pill": 999 },
  "card": { "width": 880, "inset": 4, "padding": 44 },
  "motion": { "ease": "cubic-bezier(.2,.8,.2,1)", "rise": 0.7, "fade": 0.6 },
  "theme": {
    "dark": {
      "bg": "#000000",
      "text": "#f4f4f5",
      "text2": "#a1a1aa",
      "text3": "#8b8b94",
      "text4": "#52525b",
      "accent": "#a78bfa",
      "ok": "#00c758",
      "info": "#60a5fa",
      "border": "rgba(255,255,255,.11)",
      "hairline": "rgba(255,255,255,.08)",
      "pill": "rgba(255,255,255,.18)",
      "track": "rgba(255,255,255,.06)",
      "glassTop": "rgba(255,255,255,.13)",
      "glassBottom": "rgba(255,255,255,.04)",
      "edgeTop": "rgba(255,255,255,.55)",
      "edgeMid": "rgba(255,255,255,.08)",
      "edgeBottom": "rgba(255,255,255,.20)",
      "shadow": "rgba(0,0,0,.55)",
      "glowA": "#a78bfa",
      "glowB": "#60a5fa",
      "glowStrength": 0.55
    },
    "light": {
      "bg": "#ffffff",
      "text": "#18181b",
      "text2": "#52525b",
      "text3": "#71717a",
      "text4": "#a1a1aa",
      "accent": "#7c3aed",
      "ok": "#008a3e",
      "info": "#2563eb",
      "border": "rgba(9,9,11,.12)",
      "hairline": "rgba(9,9,11,.08)",
      "pill": "rgba(9,9,11,.16)",
      "track": "rgba(9,9,11,.05)",
      "glassTop": "rgba(255,255,255,.80)",
      "glassBottom": "rgba(255,255,255,.48)",
      "edgeTop": "rgba(255,255,255,1)",
      "edgeMid": "rgba(9,9,11,.05)",
      "edgeBottom": "rgba(9,9,11,.10)",
      "shadow": "rgba(76,29,149,.16)",
      "glowA": "#a78bfa",
      "glowB": "#60a5fa",
      "glowStrength": 0.5
    }
  },
  "language": {
    "JavaScript": "#f1e05a",
    "TypeScript": "#3178c6",
    "C#": "#178600",
    "HTML": "#e34c26",
    "CSS": "#663399",
    "Vue": "#41b883",
    "Visual Basic .NET": "#945db7",
    "Other": "#71717a"
  }
}
